universe = vanilla
executable = $(repo_root)/condor/mva/run_evaluate.sh
arguments = "$(repo_root)" "$(config)" "$(model)" "$(scores_dir)" "$(evaluation)"
output = $(log_dir)/evaluate.out
error = $(log_dir)/evaluate.err
