# HTCondor submit file for ML feature export.
# One job per line of arguments.txt, generated by make_arguments.py.
# Smoke-test chunk 0 first before submitting the full production.

executable      = job_wrapper.sh
arguments       = $(config) $(chunk) $(component) $(level)

universe        = vanilla
Requirements    = OpSys == "LINUX" && Arch == "X86_64"
request_cpus    = 1
request_memory  = 2048 Mb
request_disk    = 2 GB
+RequestRuntime = 7200

# The wrapper sources env/setup.sh explicitly.
getenv          = false

log             = log/$(Cluster).$(Process).log
output          = out/$(Cluster).$(Process).out
error           = err/$(Cluster).$(Process).err

queue config,chunk,component,level from arguments.txt
