# HTCondor submit file for ML feature export.
# One job per line of arguments.txt, generated by make_arguments.py.
# Smoke-test chunk 0 first before submitting the full production.

executable      = condor/export_feature/job_wrapper_v2.sh
arguments       = $(config) $(chunk) $(component) $(level) $(out_dir)

universe        = vanilla
Requirements    = OpSys == "LINUX" && Arch == "X86_64"
request_cpus    = 1
request_memory  = 2048 Mb
request_disk    = 2 GB
+RequestRuntime = 7200

# The wrapper sources env/setup.sh explicitly.
getenv          = false

log             = condr/export_feature/log/$(Cluster).$(Process).log
output          = condor/export_feature/out/$(Cluster).$(Process).out
error           = condor/export_feature/err/$(Cluster).$(Process).err

queue config,chunk,component,level from condor/export_feature/arguments_v2.txt
